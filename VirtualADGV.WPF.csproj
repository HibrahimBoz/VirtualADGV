<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- NuGet Metadata -->
    <PackageId>VirtualADGV.WPF</PackageId>
    <Version>1.1.0</Version>
    <Authors>HibrahimBoz</Authors>
    <Description>Advanced virtual DataGrid for WPF with filtering, sorting, search and theming support.</Description>
    <PackageTags>wpf;datagrid;filter;sort;search;darkmode;excel;excel-filter;virtual;virtualization;sql-filter;grid;advanced-datagrid;datatable;wpf-controls;localization;theme</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/HibrahimBoz/VirtualADGV.WPF</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>1.1.0: crosshair highlight (selected cell's row and column), VS Code-style minimap (marks, selection, search hits; click/drag to scroll; works on 1M+ row virtual sources), built-in in-memory Ctrl+F search, theme keys ThemeCrosshairBg / ThemeSearchHitBg. Fixes: filler-header filter button exception, corner button layout loop, Items.Refresh on Ctrl+A.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
