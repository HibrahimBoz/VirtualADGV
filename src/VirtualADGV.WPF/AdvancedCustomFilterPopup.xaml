<UserControl x:Class="VirtualADGV.WPF.AdvancedCustomFilterPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VirtualADGV.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="250"
             x:Name="self"
             Background="{DynamicResource PopupBackgroundBrush}"
             Foreground="{DynamicResource PopupForegroundBrush}"
             BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1">

    <UserControl.Resources>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter" 
                                    MatchedBrush="{DynamicResource PopupForegroundBrush}" 
                                    UnmatchedBrush="{DynamicResource UnmatchedBrush}"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Default Theme Colors (Light) - will be updated by SetTheme() in code-behind -->
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="PopupForegroundBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ListBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="SearchIconBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="UnmatchedBrush" Color="#64748B"/>
        
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                               VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2">
            <Button x:Name="BtnSortAsc" Click="BtnSortAsc_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,2 L14,2 M2,8 L10,8 M2,14 L6,14 M12,10 L12,18 M9,15 L12,18 L15,15" 
                           Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,10,0" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtSortAsc" Text="{Binding Strings.SortAToZ, ElementName=self}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PopupForegroundBrush}"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnSortDesc" Click="BtnSortDesc_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M2,2 L14,2 M2,8 L10,8 M2,14 L6,14 M12,10 L12,18 M9,13 L12,10 L15,13" 
                           Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,10,0" Stretch="Uniform"/>
                    <TextBlock x:Name="TxtSortDesc" Text="{Binding Strings.SortZToA, ElementName=self}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PopupForegroundBrush}"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnClearSort" Click="BtnClearSort_Click" Style="{StaticResource MenuButtonStyle}">
                <TextBlock Text="{Binding Strings.ClearSort, ElementName=self}" VerticalAlignment="Center" FontSize="11" Margin="24,0,0,0" 
                           Foreground="{DynamicResource SubtleForegroundBrush}"/>
            </Button>

            <Separator Background="{DynamicResource DividerBrush}" Margin="4,2"/>

            <Button x:Name="BtnClearFilter" Click="BtnClearFilter_Click" Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M4,4 L12,12 M12,4 L4,12" 
                          Stroke="{DynamicResource SubtleForegroundBrush}" StrokeThickness="2" Width="12" Height="12" Margin="1,0,11,0" Stretch="Uniform"/>
                    <TextBlock Text="{Binding Strings.ClearFilter, ElementName=self}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PopupForegroundBrush}"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnCustomFilter" Click="BtnCustomFilter_Click" Style="{StaticResource MenuButtonStyle}">
                <Grid HorizontalAlignment="Stretch" Width="220">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M2,4 L14,4 L9,10 L9,16 L6,16 L6,10 Z" 
                               Fill="#FBBF24" Width="12" Height="12" Margin="1,0,11,0" Stretch="Uniform"/>
                        <TextBlock x:Name="txtMode" Text="{Binding Strings.TextFilters, ElementName=self}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PopupForegroundBrush}"/>
                    </StackPanel>
                    <Path Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource PopupForegroundBrush}" StrokeThickness="1.5" 
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Stretch="Uniform" Width="8" Height="8"/>
                </Grid>
                <Button.ContextMenu>
                    <ContextMenu x:Name="SubMenuFilters" Background="{DynamicResource PopupBackgroundBrush}" 
                                 Foreground="{DynamicResource PopupForegroundBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"/>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <Separator Grid.Row="1" Background="{DynamicResource DividerBrush}" Margin="0,2"/>

        <Border Grid.Row="1" Margin="8,4" BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1" 
                Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="2">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Data="M10,10 L14,14 M8,4 A4,4 0 1 1 8,12 A4,4 0 1 1 8,4" 
                      Stroke="{DynamicResource SearchIconBrush}" StrokeThickness="1.5" Width="12" Height="12" Margin="6,0,0,0" Stretch="Uniform"/>
                <Grid Grid.Column="1">
                    <TextBlock IsHitTestVisible="False" Text="{Binding Strings.SearchPlaceholder, ElementName=self}" Foreground="{DynamicResource SearchIconBrush}" VerticalAlignment="Center" Margin="5,0" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="TxtSearch" Background="Transparent" Foreground="{DynamicResource PopupForegroundBrush}" 
                             BorderThickness="0" Padding="5,2" FontSize="11"
                             VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="8,0,8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <CheckBox x:Name="ChkSelectAll" Grid.Row="0" Content="{Binding Strings.SelectAll, ElementName=self}" IsChecked="True" 
                       Foreground="{DynamicResource PopupForegroundBrush}" FontSize="11" Margin="5,0,0,4" Click="ChkSelectAll_Click"/>
            
            <ListBox x:Name="LstItems" Grid.Row="1" Background="{DynamicResource ListBackgroundBrush}" 
                     Foreground="{DynamicResource PopupForegroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}"
                     MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <VirtualizingStackPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="itemCheckBox" Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding IsEnabled}" FontSize="11" Margin="0,1" Click="ChkItem_Changed">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="{DynamicResource PopupForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource UnmatchedBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="4,1">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <TreeView x:Name="TreeViewItems" Grid.Row="1" Background="{DynamicResource ListBackgroundBrush}" 
                      Foreground="{DynamicResource PopupForegroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}"
                      MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding IsEnabled}" FontSize="11" Margin="0,1" Foreground="{DynamicResource PopupForegroundBrush}" Click="ChkItem_Changed" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PopupBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" 
                BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="{Binding Strings.Cancel, ElementName=self}" Click="BtnCancel_Click" Width="75" Height="26"
                        Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PopupForegroundBrush}" BorderThickness="0" Margin="0,0,8,0" FontSize="11">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnApply" Content="{Binding Strings.Apply, ElementName=self}" Click="BtnApply_Click" Width="85" Height="26"
                        Background="#10B981" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- Yükleniyor Göstergesi (Overlay) -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="4"
              Background="#A0000000" 
              Visibility="{Binding IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,15" Foreground="#3B82F6" Background="#27272A"/>
                <TextBlock Text="{Binding Strings.Loading, ElementName=self}" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
