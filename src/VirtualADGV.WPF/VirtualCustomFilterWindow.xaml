<Window x:Class="VirtualADGV.WPF.VirtualCustomFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Strings.CustomFilterTitle, ElementName=self}" Height="260" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WinBg}" Foreground="{DynamicResource WinFg}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        x:Name="self">
    <Window.Resources>
        <SolidColorBrush x:Key="WinBg" Color="#09090B"/>
        <SolidColorBrush x:Key="WinFg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TitleBg" Color="#18181B"/>
        <SolidColorBrush x:Key="TitleFg" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="ControlBg" Color="#18181B"/>
        <SolidColorBrush x:Key="ControlFg" Color="White"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#27272A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="Auto"/> <!-- Info -->
                <RowDefinition Height="10"/>   <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Row 1 -->
                <RowDefinition Height="Auto"/> <!-- Radio Buttons -->
                <RowDefinition Height="Auto"/> <!-- Row 2 -->
                <RowDefinition Height="*"/>    <!-- Spacer -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>
 
            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Margin="-15,-15,-15,10" Background="{DynamicResource TitleBg}" Height="32">
                <TextBlock Text="{Binding Strings.CustomFilterTitle, ElementName=self}" VerticalAlignment="Center" Margin="15,0" 
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TitleFg}"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="32" Background="Transparent" 
                        BorderThickness="0" Foreground="{DynamicResource TitleFg}" Click="BtnCancel_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
 
            <TextBlock Grid.Row="1" Text="{Binding Strings.FilterCriteria, ElementName=self}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
 
            <!-- Row 1 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
                <ComboBox x:Name="CmbOperator1" Width="140" Height="28"/>
                <TextBox x:Name="TxtValue1" Width="250" Height="28" Margin="10,0,0,0" VerticalContentAlignment="Center"
                         Padding="5,0" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource ControlFg}" BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource ControlFg}"/>
            </StackPanel>
 
            <!-- AND/OR -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="40,10">
                <RadioButton x:Name="RbAnd" Content="{Binding Strings.And, ElementName=self}" IsChecked="True" Foreground="{DynamicResource WinFg}" FontSize="11" Margin="0,0,20,0"/>
                <RadioButton x:Name="RbOr" Content="{Binding Strings.Or, ElementName=self}" Foreground="{DynamicResource WinFg}" FontSize="11"/>
            </StackPanel>
 
            <!-- Row 2 -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5">
                <ComboBox x:Name="CmbOperator2" Width="140" Height="28"/>
                <TextBox x:Name="TxtValue2" Width="250" Height="28" Margin="10,0,0,0" VerticalContentAlignment="Center"
                         Padding="5,0" Background="{DynamicResource ControlBg}" Foreground="{DynamicResource ControlFg}" BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource ControlFg}"/>
            </StackPanel>
 
            <!-- Buttons -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding Strings.Ok, ElementName=self}" Width="80" Height="28" Background="#2563EB" Foreground="White" 
                        BorderThickness="0" Click="BtnOk_Click" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="{Binding Strings.Cancel, ElementName=self}" Width="80" Height="28" Background="{DynamicResource BorderBrush}" Foreground="{DynamicResource WinFg}" 
                        BorderThickness="0" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
